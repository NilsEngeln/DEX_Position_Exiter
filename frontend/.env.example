# Frontend environment variables (Vite)
# Copy to .env and fill in after deploying contracts

# API URL (leave empty to use Vite proxy in dev, set for production)
VITE_API_URL=

# Sepolia RPC URL (for read-only calls; MetaMask handles wallet RPC)
VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Contract addresses (from DeploySepolia.s.sol output)
VITE_POOL_MANAGER_ADDRESS=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
VITE_HOOK_ADDRESS=0x_FILL_AFTER_DEPLOY
VITE_TOKEN0_ADDRESS=0x_FILL_AFTER_DEPLOY
VITE_TOKEN1_ADDRESS=0x_FILL_AFTER_DEPLOY
VITE_SWAP_ROUTER_ADDRESS=0x9b6b46e2c869aa39918db7f52f5557fe577b6eee
VITE_MODIFY_LIQUIDITY_ROUTER_ADDRESS=0x0c478023803a644c94c4ce1c1e7b9a087e411b0a
