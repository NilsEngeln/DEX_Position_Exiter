# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# Blockchain RPC URLs
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://mainnet.base.org

# Contract Addresses (deployed addresses)
POOL_MANAGER_ADDRESS_SEPOLIA=0x...
HOOK_ADDRESS_SEPOLIA=0x...

# x402 Payment Configuration
X402_FACILITATOR_URL=https://x402.org/facilitator
PAYMENT_ADDRESS=0x...

# Skip payment verification for development
SKIP_PAYMENT=true

# Private key for transaction signing (use a dedicated deployer wallet)
# NEVER commit real private keys!
DEPLOYER_PRIVATE_KEY=0x...

# Database (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/dex_exiter

# Redis (for production rate limiting)
# REDIS_URL=redis://localhost:6379
