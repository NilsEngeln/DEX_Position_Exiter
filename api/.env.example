# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# Sepolia RPC URL (get a free key from Alchemy or Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Contract Addresses (fill in after running DeploySepolia.s.sol)
POOL_MANAGER_ADDRESS=0xE03A1074c86CFeDd5C142C4F04F1a1536e203543
HOOK_ADDRESS=0x_FILL_AFTER_DEPLOY
TOKEN0_ADDRESS=0x_FILL_AFTER_DEPLOY
TOKEN1_ADDRESS=0x_FILL_AFTER_DEPLOY
SWAP_ROUTER_ADDRESS=0x9b6b46e2c869aa39918db7f52f5557fe577b6eee
MODIFY_LIQUIDITY_ROUTER_ADDRESS=0x0c478023803a644c94c4ce1c1e7b9a087e411b0a

# Deployer private key (use a dedicated dev wallet, NOT your main wallet!)
# NEVER commit real private keys!
DEPLOYER_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY

# x402 Payment Configuration
SKIP_PAYMENT=true
PAYMENT_ADDRESS=0x0000000000000000000000000000000000000001

# x402 Facilitator (for production)
# X402_FACILITATOR_URL=https://x402.org/facilitator
